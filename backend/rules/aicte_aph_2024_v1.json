{
  "version_code": "AICTE-APH-2024-V1",
  "handbook_name": "AICTE Approval Process Handbook 2024-25",
  "effective_from": "2024-01-01",
  "effective_to": "2024-12-31",
  "description": "Standard quota ceilings with 15% supernumerary cap and strict departmental allocation without inter-quota cascade to NRI.",
  "intake_rules": {
    "max_over_intake_percent": 0.0,
    "supernumerary_cap_percent": 15.0,
    "sub_quotas": {
      "EWS": {
        "cap_percent_of_intake": 10.0,
        "is_supernumerary": true,
        "requires_accreditation": false
      },
      "TFW": {
        "cap_percent_of_intake": 5.0,
        "is_supernumerary": true,
        "requires_accreditation": false
      },
      "FN_OCI_CIWGC": {
        "cap_percent_of_intake": 15.0,
        "is_supernumerary": true,
        "requires_accreditation": true
      },
      "NRI": {
        "cap_percent_of_intake": 5.0,
        "is_supernumerary": false,
        "within_approved_intake": true,
        "requires_accreditation": true
      }
    },
    "cascade_rules": {
      "allow_vacant_supernumerary_to_nri": false,
      "allow_ciwgc_to_fn_cascade": true
    }
  }
}
